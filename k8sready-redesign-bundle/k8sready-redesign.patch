+    border-left: 0;
+  }
+
+  .about-grid,
+  .contact-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .cert-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (max-width: 640px) {
+  .hero-inner,
+  .section-inner,
+  .footer-inner {
+    width: min(100% - 28px, var(--content-width));
+  }
+
+  .hero-inner {
+    padding-top: 62px;
+  }
+
+  .hero-title {
+    font-size: clamp(2.75rem, 14vw, 4.3rem);
+  }
+
+  .hero-visual {
+    min-height: 260px;
+  }
+
+  .stats-bar {
+    grid-template-columns: 1fr;
+  }
+
+  .stat,
+  .stat:nth-child(2) {
+    border-right: 0;
