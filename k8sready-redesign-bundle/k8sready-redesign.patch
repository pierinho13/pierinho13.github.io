+
+  .nav-link {
+    display: flex;
+    padding: 10px 12px;
+    border-radius: 9px;
+  }
+
+  .nav-link:hover,
+  .nav-link.active {
+    background: rgba(139, 92, 246, 0.12);
+  }
+
+  .nav-link::after {
+    display: none;
+  }
+
+  .language-switcher {
