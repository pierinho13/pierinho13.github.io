diff --git a/assets/css/site.css b/assets/css/site.css
new file mode 100644
index 0000000000000000000000000000000000000000..bda95594f71796b6fa9554bccdecb53cef7eff76
--- /dev/null
+++ b/assets/css/site.css
@@ -0,0 +1,1387 @@
+:root {
+  color-scheme: light;
+  --navy-950: #07142f;
+  --navy-900: #0b1d42;
+  --navy-850: #10275a;
+  --indigo-700: #4338ca;
+  --indigo-600: #4f46e5;
+  --indigo-500: #6366f1;
+  --violet-500: #8b5cf6;
+  --violet-400: #a78bfa;
+  --amber-400: #fbbf24;
+  --sky-400: #38bdf8;
+  --surface: #ffffff;
+  --surface-soft: #f7f8fc;
+  --surface-muted: #eef2ff;
+  --text: #172033;
+  --text-soft: #566176;
+  --text-muted: #778197;
+  --border: #dfe5f1;
+  --border-strong: #cbd4e5;
+  --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.08);
+  --shadow-md: 0 18px 45px rgba(15, 23, 42, 0.12);
+  --shadow-lg: 0 30px 80px rgba(7, 20, 47, 0.3);
+  --radius-sm: 10px;
+  --radius-md: 16px;
+  --radius-lg: 24px;
+  --content-width: 1180px;
+  --reading-width: 860px;
+  --header-height: 76px;
+}
+
+[data-theme="dark"] {
+  color-scheme: dark;
+  --surface: #101a32;
+  --surface-soft: #0b1428;
+  --surface-muted: #18264a;
+  --text: #f7f8ff;
+  --text-soft: #c7cee0;
+  --text-muted: #99a4bc;
+  --border: #253454;
+  --border-strong: #36466a;
+  --shadow-sm: 0 8px 24px rgba(0, 0, 0, 0.24);
+  --shadow-md: 0 18px 45px rgba(0, 0, 0, 0.34);
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  scroll-behavior: smooth;
+  scroll-padding-top: calc(var(--header-height) + 22px);
+}
+
+body {
+  margin: 0;
+  min-width: 320px;
+  background: var(--surface-soft);
+  color: var(--text);
+  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  line-height: 1.6;
+  -webkit-font-smoothing: antialiased;
+}
+
+body,
+.site-header,
+.page-frame,
+.blog-card,
+.project-card,
+.info-card,
+.contact-card,
+.site-footer {
+  transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
+}
+
+img,
+svg {
+  max-width: 100%;
+}
+
+a {
+  color: inherit;
+}
+
+button,
+a {
+  -webkit-tap-highlight-color: transparent;
+}
+
+.skip-link {
+  position: fixed;
+  top: 10px;
+  left: 10px;
+  z-index: 9999;
+  transform: translateY(-150%);
+  padding: 10px 14px;
+  border-radius: 8px;
+  background: white;
+  color: #111827;
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+/* Header */
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  min-height: var(--header-height);
+  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
+  background: rgba(7, 20, 47, 0.94);
+  color: #fff;
+  backdrop-filter: blur(18px);
+}
+
+.header-inner {
+  width: min(var(--content-width), calc(100% - 40px));
+  min-height: var(--header-height);
+  margin: 0 auto;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 28px;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  color: #fff;
+  text-decoration: none;
+  font-size: 1.32rem;
+  font-weight: 800;
+  letter-spacing: -0.04em;
+}
+
+.brand-mark {
+  width: 34px;
+  height: 34px;
+  display: grid;
+  place-items: center;
+  border: 1px solid rgba(167, 139, 250, 0.45);
+  border-radius: 11px;
+  background: linear-gradient(145deg, var(--indigo-500), var(--violet-500));
+  box-shadow: 0 8px 24px rgba(99, 102, 241, 0.34);
+}
+
+.brand-mark svg {
+  width: 22px;
+  height: 22px;
+}
+
+.brand-text {
+  background: linear-gradient(90deg, #a78bfa, #c4b5fd 52%, #fff);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+
+.header-actions,
+.primary-nav,
+.primary-nav ul,
+.language-switcher {
+  display: flex;
+  align-items: center;
+}
+
+.header-actions {
+  gap: 20px;
+}
+
+.primary-nav ul {
+  margin: 0;
+  padding: 0;
+  gap: 28px;
+  list-style: none;
+}
+
+.nav-link {
+  position: relative;
+  display: inline-flex;
+  padding: 9px 0;
+  color: #dbe4ff;
+  font-size: 0.92rem;
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.nav-link::after {
+  content: "";
+  position: absolute;
+  right: 0;
+  bottom: 2px;
+  left: 0;
+  height: 2px;
+  transform: scaleX(0);
+  border-radius: 999px;
+  background: linear-gradient(90deg, var(--violet-400), var(--indigo-500));
+  transition: transform 0.2s ease;
+}
+
+.nav-link:hover,
+.nav-link.active {
+  color: #fff;
+}
+
+.nav-link:hover::after,
+.nav-link.active::after {
+  transform: scaleX(1);
+}
+
+.language-switcher {
+  gap: 6px;
+  padding-left: 18px;
+  border-left: 1px solid rgba(255, 255, 255, 0.12);
+}
+
+.language-link {
+  padding: 6px 7px;
+  border-radius: 8px;
+  color: #aab6d3;
+  font-size: 0.82rem;
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.language-link:hover,
+.language-link.active {
+  background: rgba(139, 92, 246, 0.14);
+  color: #fff;
+}
+
+.icon-button,
+.menu-toggle {
+  width: 38px;
+  height: 38px;
+  display: inline-grid;
+  place-items: center;
+  padding: 0;
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.045);
+  color: #fff;
+  cursor: pointer;
+}
+
+.icon-button:hover,
+.menu-toggle:hover {
+  border-color: rgba(167, 139, 250, 0.58);
+  background: rgba(139, 92, 246, 0.14);
+}
+
+.icon-button svg,
+.menu-toggle svg {
+  width: 19px;
+  height: 19px;
+}
+
+.menu-toggle {
+  display: none;
+}
+
+/* Main */
+.site-main {
+  min-height: calc(100vh - var(--header-height));
+}
+
+.page-frame {
+  width: min(var(--reading-width), calc(100% - 32px));
+  margin: 42px auto 64px;
+  padding: clamp(30px, 5vw, 58px);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--surface);
+  box-shadow: var(--shadow-md);
+}
+
+.page-frame--wide {
+  width: min(var(--content-width), calc(100% - 32px));
+}
+
+.page-frame h1 {
+  margin: 0 0 16px;
+  color: var(--text);
+  font-size: clamp(2.2rem, 5vw, 3.5rem);
+  line-height: 1.08;
+  letter-spacing: -0.045em;
+}
+
+.page-frame h2 {
+  margin: 46px 0 18px;
+  color: var(--text);
+  font-size: clamp(1.45rem, 3vw, 2rem);
+  line-height: 1.2;
+  letter-spacing: -0.025em;
+}
+
+.page-frame p {
+  color: var(--text-soft);
+}
+
+/* Buttons */
+.button-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 14px;
+}
+
+.button {
+  min-height: 48px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  padding: 12px 19px;
+  border: 1px solid transparent;
+  border-radius: 12px;
+  font-weight: 750;
+  text-decoration: none;
+  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
+}
+
